---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const crumbs = [{ name: 'Accueil', href: '/' }, { name: 'Aides 2026', href: '/aides-borne-recharge-2026/' }];
const faq = [
  { q: 'Le crédit d’impôt pour borne de recharge existe-t-il encore en 2026 ?', a: 'Non. Le crédit d’impôt pour l’installation d’une borne de recharge ne s’applique plus aux dépenses payées depuis le 1er janvier 2026.' },
  { q: 'Quelle aide pour une borne en copropriété ?', a: 'La prime Advenir finance une partie de l’installation, qu’il s’agisse d’une infrastructure collective votée en assemblée générale ou, selon les conditions en vigueur, d’une borne individuelle. Nous montons le dossier avec vous.' },
  { q: 'Un particulier en maison peut-il toucher la prime Advenir ?', a: 'Non. La prime Advenir est réservée aux projets collectifs : copropriétés, entreprises, flottes, parkings ouverts au public et collectivités, selon les catégories en vigueur.' },
  { q: 'Existe-t-il des aides locales dans l’Yonne ?', a: 'Des dispositifs ponctuels peuvent exister au niveau régional ou intercommunal, notamment pour les entreprises et les collectivités. Nous vérifions les aides mobilisables au moment du devis.' },
];
const schema = [
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'Article', headline: 'Aides pour une borne de recharge en 2026 dans l’Yonne', inLanguage: 'fr-FR', dateModified: new Date().toISOString().slice(0, 10), author: { '@id': new URL('/#entreprise', Astro.site).href }, publisher: { '@id': new URL('/#entreprise', Astro.site).href } },
];
---
<Base title="Aides borne de recharge 2026 : prime Advenir, crédit d’impôt | Yonne" description="Quelles aides pour installer une borne de recharge en 2026 ? Prime Advenir pour copropriétés et entreprises, fin du crédit d’impôt. Le point clair par un installateur IRVE de l’Yonne." breadcrumbs={crumbs} schema={schema} type="article">
  <section class="pagetop">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Aides pour une borne de recharge <span class="hl">en 2026</span></h1>
      <p class="lead">Les dispositifs réellement en vigueur cette année, expliqués simplement.</p>
    </div>
  </section>
  <section class="block dark">
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow">Ce à quoi vous avez droit</span><h2>On vous accompagne sur les démarches</h2><p>Les aides dépendent de votre projet. On vous oriente vers ce qui s’applique vraiment à votre situation.</p></div>
      <div class="aide-grid">
        <div class="aide reveal"><div class="tag">Devis clair</div><h3>Un prix juste, sans surprise</h3><p>Visite technique sur place, puis un devis détaillé : matériel, main-d’œuvre, éventuels travaux sur le tableau. Ce qui est écrit est ce que vous payez.</p><div class="note">Gratuit et sans engagement, sous 48 h.</div></div>
        <div class="aide reveal"><div class="tag">Prime Advenir</div><h3>Pour les projets collectifs</h3><p>Financement d’une partie de l’installation en copropriété, entreprise ou collectivité. Le montant dépend de la catégorie du projet.</p><div class="note">Réservée aux installations collectives — pas la maison individuelle.</div></div>
        <div class="aide off reveal"><div class="tag">Crédit d’impôt</div><h3>Supprimé pour les dépenses 2026</h3><p>Le crédit d’impôt borne de recharge ne s’applique plus aux dépenses payées depuis le 1ᵉʳ janvier 2026.</p><div class="note">Ne vous fiez pas aux anciens simulateurs.</div></div>
      </div>
      <p style="margin-top:24px;font-size:.86rem;color:#7e90a8;max-width:70ch">Information donnée à titre indicatif, à jour pour 2026. Les conditions exactes sont vérifiées au cas par cas lors du devis.</p>
    </div>
  </section>
  <section class="block">
    <div class="wrap prose">
      <div class="answer"><span class="lbl">En bref</span><p>En 2026, le crédit d’impôt pour l’installation d’une borne de recharge n’existe plus pour les dépenses payées depuis le 1er janvier. L’aide principale est la prime Advenir, réservée aux copropriétés, entreprises, flottes et collectivités.</p></div>
      <h2>Récapitulatif par type de projet</h2>
      <div class="tbl-wrap"><table>
        <thead><tr><th>Projet</th><th>Prime Advenir</th><th>Crédit d’impôt</th></tr></thead>
        <tbody>
          <tr><td>Maison individuelle</td><td>Non</td><td>Non (depuis 2026)</td></tr>
          <tr><td>Borne individuelle en copropriété</td><td>Selon le projet</td><td>Non (depuis 2026)</td></tr>
          <tr><td>Infrastructure collective copropriété</td><td>Oui</td><td>—</td></tr>
          <tr><td>Entreprise, flotte, parking public</td><td>Selon la catégorie</td><td>—</td></tr>
        </tbody>
      </table></div>
      <h2>Questions fréquentes sur les aides</h2>
      <Faq items={faq} />
    </div>
  </section>
  <section class="block" style="padding-top:0"><div class="wrap"><CtaBand title="Connaître les aides pour votre projet" text="On calcule tout dans le devis gratuit, aides comprises." /></div></section>
</Base>
