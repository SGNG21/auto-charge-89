---
import Icon from './Icon.astro';
import { SITE } from '../data/site.js';
interface Props { city?: string; heading?: string }
const { city = '', heading = 'Demandez votre devis gratuit' } = Astro.props;
---
<div class="form-card" id="devis">
  <form id="quote-form" action="/api/contact" method="post" novalidate>
    <h2>{heading}</h2>
    <p class="sub">Réponse sous 48 h. Sans engagement.</p>
    <div class="row2">
      <div class="field"><label for="f-name">Nom</label><input id="f-name" name="name" type="text" autocomplete="name" required placeholder="Votre nom" /></div>
      <div class="field"><label for="f-tel">Téléphone</label><input id="f-tel" name="phone" type="tel" autocomplete="tel" required placeholder="06 …" /></div>
    </div>
    <div class="row2">
      <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" placeholder="vous@exemple.fr" /></div>
      <div class="field"><label for="f-city">Commune</label><input id="f-city" name="city" type="text" autocomplete="address-level2" value={city} placeholder="Ex. Auxerre" /></div>
    </div>
    <div class="field"><label for="f-type">Type de projet</label>
      <select id="f-type" name="project">
        <option>Maison individuelle</option><option>Copropriété</option><option>Entreprise / flotte</option><option>Je ne sais pas encore</option>
      </select>
    </div>
    <div class="field"><label for="f-msg">Votre projet</label><textarea id="f-msg" name="message" placeholder="Modèle de voiture, emplacement souhaité, distance au tableau électrique, délai…"></textarea></div>
    <div class="hp" aria-hidden="true"><label>Ne pas remplir <input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <label class="rgpd"><input type="checkbox" name="consent" required /><span>J’accepte que mes informations soient utilisées pour être recontacté au sujet de ma demande. <a href="/politique-confidentialite/" style="text-decoration:underline">En savoir plus</a></span></label>
    <button class="btn btn-primary" type="submit">Envoyer ma demande <Icon name="arrow" /></button>
    <p class="form-err" role="alert" hidden></p>
  </form>
  <div class="form-ok" hidden>
    <div class="check"><Icon name="check" /></div>
    <h3>Demande envoyée !</h3>
    <p style="color:var(--ink-soft)">Merci, on vous rappelle très vite. Pour une urgence : <a href={`tel:${SITE.phoneIntl}`} style="font-weight:700">{SITE.phone}</a></p>
  </div>
</div>
<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  if (form) {
    const err = form.querySelector('.form-err') as HTMLElement;
    const ok = form.parentElement!.querySelector('.form-ok') as HTMLElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      if (!form.checkValidity()) {
        err.textContent = 'Merci d’indiquer votre nom, votre téléphone et d’accepter d’être recontacté.';
        err.hidden = false;
        form.reportValidity();
        return;
      }
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      const data = Object.fromEntries(new FormData(form).entries());
      data.page = location.pathname;
      try {
        const r = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (!r.ok) throw new Error(String(r.status));
        form.hidden = true;
        ok.hidden = false;
        (window as any).dataLayer?.push({ event: 'generate_lead' });
      } catch {
        const body = encodeURIComponent(`Nom : ${data.name}\nTéléphone : ${data.phone}\nCommune : ${data.city}\nProjet : ${data.project}\n\n${data.message}`);
        err.innerHTML = `L’envoi n’a pas abouti. Appelez-nous au <a href="tel:+33695048946"><b>06 95 04 89 46</b></a> ou <a href="mailto:auto.charge89@gmail.com?subject=Demande%20de%20devis&body=${body}"><b>envoyez-nous un email</b></a>.`;
        err.hidden = false;
        btn.disabled = false;
      }
    });
  }
</script>
