---
import Icon from './Icon.astro';
import { SITE } from '../data/site.js';
interface Props { city?: string; heading?: string }
const { city = '', heading = 'Demandez votre devis gratuit' } = Astro.props;
---
<div class="form-card" id="devis">
  <form id="quote-form" action="/api/contact" method="post" novalidate>
    <h2>{heading}</h2>
    <p class="sub">Réponse sous 48 h. Sans engagement.</p>
    <div class="row2">
      <div class="field"><label for="f-name">Nom</label><input id="f-name" name="name" type="text" autocomplete="name" required placeholder="Votre nom" /></div>
      <div class="field"><label for="f-tel">Téléphone</label><input id="f-tel" name="phone" type="tel" autocomplete="tel" required placeholder="06 …" /></div>
    </div>
    <div class="row2">
      <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" placeholder="vous@exemple.fr" /></div>
      <div class="field"><label for="f-city">Commune</label><input id="f-city" name="city" type="text" autocomplete="address-level2" value={city} placeholder="Ex. Auxerre" /></div>
    </div>
    <div class="field"><label for="f-type">Type de projet</label>
      <select id="f-type" name="project">
        <option>Maison individuelle</option><option>Copropriété</option><option>Entreprise / flotte</option><option>Je ne sais pas encore</option>
      </select>
    </div>
    <div class="field"><label for="f-msg">Votre projet</label><textarea id="f-msg" name="message" placeholder="Modèle de voiture, emplacement souhaité, distance au tableau électrique, délai…"></textarea></div>
    <div class="field upload">
      <label for="f-photos">Photo de votre tableau électrique <span class="opt">(facultatif)</span></label>
      <p class="hint">Ouvrez le capot du tableau et prenez-le en photo, bien éclairé : cela nous permet de chiffrer plus précisément votre installation.</p>
      <input id="f-photos" name="photos_input" type="file" accept="image/*" multiple hidden />
      <button type="button" class="btn btn-line upload-btn" id="photo-btn"><Icon name="camera" /> Ajouter une photo</button>
      <ul class="thumbs" id="thumbs" aria-live="polite"></ul>
    </div>
    <div class="hp" aria-hidden="true"><label>Ne pas remplir <input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <label class="rgpd"><input type="checkbox" name="consent" required /><span>J’accepte que mes informations soient utilisées pour être recontacté au sujet de ma demande. <a href="/politique-confidentialite/" style="text-decoration:underline">En savoir plus</a></span></label>
    <button class="btn btn-primary" type="submit">Envoyer ma demande <Icon name="arrow" /></button>
    <p class="form-err" role="alert" hidden></p>
  </form>
  <div class="form-ok" hidden>
    <div class="check"><Icon name="check" /></div>
    <h3>Demande envoyée !</h3>
    <p class="ok-conf" style="color:var(--ink-soft);margin-bottom:8px" hidden>Un email de confirmation vient de vous être envoyé.</p>
    <p style="color:var(--ink-soft)">Merci, on vous rappelle très vite. Pour une urgence : <a href={`tel:${SITE.phoneIntl}`} style="font-weight:700">{SITE.phone}</a></p>
  </div>
</div>
<script>
  const MAX_PHOTOS = 3;
  const MAX_DIM = 1600;
  const MAX_B64 = 1_300_000; // ~1 Mo par photo après compression
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  if (form) {
    const err = form.querySelector('.form-err') as HTMLElement;
    const ok = form.parentElement!.querySelector('.form-ok') as HTMLElement;
    const input = document.getElementById('f-photos') as HTMLInputElement;
    const pickBtn = document.getElementById('photo-btn') as HTMLButtonElement;
    const thumbs = document.getElementById('thumbs') as HTMLUListElement;
    const photos: { url: string; b64: string }[] = [];

    // Réduit la photo (taille et poids) avant envoi : un cliché de téléphone fait plusieurs Mo.
    const compress = async (file: File): Promise<{ url: string; b64: string }> => {
      const bmp = await createImageBitmap(file);
      const ratio = Math.min(1, MAX_DIM / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas');
      c.width = Math.round(bmp.width * ratio);
      c.height = Math.round(bmp.height * ratio);
      c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
      let q = 0.78, url = c.toDataURL('image/jpeg', q);
      while (url.length > MAX_B64 && q > 0.4) { q -= 0.1; url = c.toDataURL('image/jpeg', q); }
      if (url.length > MAX_B64) throw new Error('too_big');
      return { url, b64: url.split(',')[1] };
    };
    const render = () => {
      thumbs.innerHTML = '';
      photos.forEach((p, i) => {
        const li = document.createElement('li');
        const img = document.createElement('img');
        img.src = p.url; img.alt = `Photo ${i + 1}`;
        const rm = document.createElement('button');
        rm.type = 'button'; rm.setAttribute('aria-label', `Retirer la photo ${i + 1}`); rm.textContent = '×';
        rm.addEventListener('click', () => { photos.splice(i, 1); render(); });
        li.append(img, rm);
        thumbs.append(li);
      });
      pickBtn.hidden = photos.length >= MAX_PHOTOS;
    };
    pickBtn.addEventListener('click', () => input.click());
    input.addEventListener('change', async () => {
      err.hidden = true;
      for (const f of Array.from(input.files || [])) {
        if (photos.length >= MAX_PHOTOS) break;
        try { photos.push(await compress(f)); }
        catch { err.textContent = 'Cette photo n’a pas pu être lue. Essayez-en une autre (JPEG ou PNG).'; err.hidden = false; }
      }
      input.value = '';
      render();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      if (!form.checkValidity()) {
        err.textContent = 'Merci d’indiquer votre nom, votre téléphone et d’accepter d’être recontacté.';
        err.hidden = false;
        form.reportValidity();
        return;
      }
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      const data: Record<string, any> = Object.fromEntries(new FormData(form).entries());
      delete data.photos_input;
      data.page = location.pathname;
      data.photos = photos.map((p) => ({ type: 'image/jpeg', data: p.b64 }));
      try {
        const r = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (!r.ok) throw new Error(String(r.status));
        const res = await r.json().catch(() => ({}));
        form.hidden = true;
        (ok.querySelector('.ok-conf') as HTMLElement).hidden = !res.confirmation;
        ok.hidden = false;
        (window as any).dataLayer?.push({ event: 'generate_lead' });
      } catch {
        const body = encodeURIComponent(`Nom : ${data.name}\nTéléphone : ${data.phone}\nCommune : ${data.city}\nProjet : ${data.project}\n\n${data.message}`);
        err.innerHTML = `L’envoi n’a pas abouti. Appelez-nous au <a href="tel:+33695048946"><b>06 95 04 89 46</b></a> ou <a href="mailto:auto.charge89@gmail.com?subject=Demande%20de%20devis&body=${body}"><b>envoyez-nous un email</b></a>.`;
        err.hidden = false;
        btn.disabled = false;
      }
    });
  }
</script>
